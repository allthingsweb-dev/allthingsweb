      "$description": "The slash and display at 36px and up only."
    },
    "white": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1]
      },
      "$description": "Text on filled buttons."
    }
  },
  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": ["Archivo", "sans-serif"],
      "$description": "Display and text, used at three widths."
    },
    "mono": {
      "$value": ["Geist Mono", "ui-monospace", "monospace"],
      "$description": "Meta: dates, labels, links."
    }
  },
  "type": {
    "$type": "typography",
    "wordmark": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": {
          "value": 168,
          "unit": "px"
        },
        "fontWeight": 800,
        "lineHeight": 0.84,
        "letterSpacing": {
          "value": -7.56,
          "unit": "px"
        }
      },
      "$description": "The master wordmark.",
      "$extensions": {
        "dev.allthings": {
          "width": "112%",
          "letterSpacingEm": -0.045
        }
      }
    },
    "eventLockup": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": {
          "value": 72,
          "unit": "px"
        },
        "fontWeight": 800,
        "lineHeight": 0.9,
        "letterSpacing": {
          "value": -2.88,
          "unit": "px"
        }
      },
      "$description": "all things/<topic>.",
      "$extensions": {
        "dev.allthings": {
          "width": "112%",
          "letterSpacingEm": -0.04
        }
      }
    },
    "label": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": {
          "value": 40,
          "unit": "px"
        },
        "fontWeight": 700,
        "lineHeight": 1,
        "letterSpacing": {
          "value": -0.4,
          "unit": "px"
        }
      },
      "$description": "Neighborhood, date and host labels.",
      "$extensions": {
        "dev.allthings": {
          "width": "75%",
          "letterSpacingEm": -0.01,
          "textTransform": "uppercase"
        }
      }
    },
    "lead": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": {
          "value": 30,
          "unit": "px"
        },
        "fontWeight": 500,
        "lineHeight": 1.25,
        "letterSpacing": {
          "value": -0.3,
          "unit": "px"
        }
      },
      "$description": "The two sentences and other lead copy.",
      "$extensions": {
        "dev.allthings": {
          "width": "100%",
          "letterSpacingEm": -0.01
        }
      }
    },
    "listName": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": {
          "value": 21,
          "unit": "px"
        },
        "fontWeight": 700,
        "lineHeight": 1.3,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      },
      "$description": "Event names in lists.",
      "$extensions": {
        "dev.allthings": {
          "width": "100%",
          "letterSpacingEm": 0
        }
      }
    },
    "listPlace": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": {
          "value": 14,
          "unit": "px"
        },
        "fontWeight": 600,
        "lineHeight": 1.3,
        "letterSpacing": {
          "value": 0.84,
          "unit": "px"
        }
      },
      "$description": "Neighborhoods in lists.",
      "$extensions": {
        "dev.allthings": {
          "width": "75%",
          "letterSpacingEm": 0.06,
          "textTransform": "uppercase"
        }
      }
    },
    "body": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": {
          "value": 18,
          "unit": "px"
        },
        "fontWeight": 400,
        "lineHeight": 1.55,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      },
      "$description": "Body copy.",
      "$extensions": {
        "dev.allthings": {
          "width": "100%",
          "letterSpacingEm": 0
        }
      }
    },
    "meta": {
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": {
          "value": 14,
          "unit": "px"
        },
        "fontWeight": 500,
        "lineHeight": 1.5,
        "letterSpacing": {
          "value": 0.84,
          "unit": "px"
        }
      },
      "$description": "Dates, times and labels in mono.",
      "$extensions": {
        "dev.allthings": {
          "letterSpacingEm": 0.06,
          "textTransform": "uppercase"
        }
      }
    }
  },
  "layout": {
    "$type": "dimension",
    "gutter": {
      "$value": {
        "value": 24,
        "unit": "px"
      },
      "$description": "Gutter of the 12-column grid."
    },
    "margin": {
      "$value": {
        "value": 64,
        "unit": "px"
      },
      "$description": "Page margin at desktop widths."
    }
  },
  "motion": {
    "cursorBlink": {
      "$type": "duration",
      "$value": {
        "value": 1100,
        "unit": "ms"
      },
      "$description": "One blink of the cursor; it stops for reduced motion."
    }
  },
  "theme": {
    "$description": "What each color does in each mode. Paper is the light mode and Night the dark one; pages use these roles rather than the palette.",
    "paper": {
      "$type": "color",
      "ground": {
        "$value": "{color.paper}",
        "$description": "Page ground."
      },
      "surface": {
        "$value": "{color.karl}",
        "$description": "Quiet surfaces."
      },
      "rule": {
        "$value": "{color.rulePaper}",
        "$description": "Hairline rules."
      },
      "text": {
        "$value": "{color.ink}",
        "$description": "Body text."
      },
      "meta": {
        "$value": "{color.karlText}",
        "$description": "Dates and meta."
      },
      "link": {
        "$value": "{color.violet}",
        "$description": "Neighborhoods and links."
      },
      "slash": {
        "$value": "{color.bridge}",
        "$description": "The slash and the cursor."
      },
      "button": {
        "$value": "{color.bridgeDeep}",
        "$description": "Filled buttons."
      },
      "buttonText": {
        "$value": "{color.white}",
        "$description": "Button labels."
      }
    },
    "night": {
      "$type": "color",
      "ground": {
        "$value": "{color.night}",
        "$description": "Page ground."
      },
      "surface": {
        "$value": "{color.nightRaised}",
        "$description": "Quiet surfaces."
      },
      "rule": {
        "$value": "{color.ruleNight}",
        "$description": "Hairline rules."
      },
      "text": {
        "$value": "{color.paper}",
        "$description": "Body text."
      },
      "meta": {
        "$value": "{color.dusk}",
        "$description": "Dates and meta."
      },
      "link": {
        "$value": "{color.lavender}",
        "$description": "Neighborhoods and links."
      },
      "slash": {
        "$value": "{color.glow}",
        "$description": "The slash and the cursor."
      },
      "button": {
        "$value": "{color.bridge}",
        "$description": "Filled buttons."
      },
      "buttonText": {
        "$value": "{color.white}",
        "$description": "Button labels."
      }
    }
  },
  "$extensions": {
    "dev.allthings": {
      "gridColumns": 12,
      "contrast": [
        {
          "text": "{color.ink}",
          "background": "{color.paper}",
          "minLc": 90,
          "use": "Body text on Paper"
        },
        {
          "text": "{color.bridgeDeep}",
          "background": "{color.paper}",
          "minLc": 75,
          "use": "Small orange text on Paper"
        },
        {
          "text": "{color.violet}",
          "background": "{color.paper}",
          "minLc": 75,
          "use": "Neighborhoods and links on Paper"
        },
        {
          "text": "{color.karlText}",
          "background": "{color.paper}",
          "minLc": 75,
          "use": "Meta on Paper"
        },
        {
          "text": "{color.bridge}",
          "background": "{color.paper}",
          "minLc": 60,
          "use": "Orange text at 24px and up"
        },
        {
          "text": "{color.paper}",
          "background": "{color.night}",
          "minLc": 90,
          "use": "Body text on Night"
        },
        {
          "text": "{color.mist}",
          "background": "{color.night}",
          "minLc": 75,
          "use": "Secondary text on Night"
        },
        {
          "text": "{color.dusk}",
          "background": "{color.night}",
          "minLc": 75,
          "use": "Meta on Night"
        },
        {
          "text": "{color.lavender}",
          "background": "{color.night}",
          "minLc": 75,
          "use": "Neighborhoods and links on Night"
        },
        {
          "text": "{color.glow}",
          "background": "{color.night}",
          "minLc": 45,
          "use": "The slash and display on Night"
        },
        {
          "text": "{color.white}",
          "background": "{color.bridgeDeep}",
          "minLc": 75,
          "use": "Paper button labels"
        },
        {
          "text": "{color.white}",
          "background": "{color.bridge}",
          "minLc": 75,
          "use": "Night button labels"
        },
        {
          "text": "{color.white}",
          "background": "{color.violet}",
          "minLc": 75,
          "use": "Text on violet fills"
        }
      ]
    }
  }
}
