    "mist": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.890196, 0.862745, 0.968627]
      },
      "$description": "Secondary text on Night."
    },
    "dusk": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.85098, 0.827451, 0.878431]
      },
      "$description": "Dates and meta on Night."
    },
    "lavender": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.854902, 0.811765, 1]
      },
      "$description": "Neighborhoods and links on Night."
    },
    "glow": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.415686, 0.239216]
