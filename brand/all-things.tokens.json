    "karl": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.901961, 0.886275, 0.862745]
      },
      "$description": "Quiet surfaces on Paper, named for the fog."
    },
    "rulePaper": {
      "$value": {
