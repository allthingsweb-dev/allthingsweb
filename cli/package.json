{
  "name": "allthings",
  "version": "2.6.0",
  "description": "allthings from your terminal and your agents: the evenings, who is on stage and how to get in.",
  "license": "MIT",
  "keywords": [
    "allthings",
    "events",
    "meetups",
    "san francisco",
    "mcp",
    "cli"
  ],
  "homepage": "https://allthings.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allthings-sf/allthingsweb.git",
    "directory": "cli"
  },
  "bugs": "https://github.com/allthings-sf/allthingsweb/issues",
  "type": "module",
  "bin": {
    "allthings": "./dist/index.js",
    "atw": "./dist/atw.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/atw.ts --target=bun --minify --splitting --outdir dist",
    "prepack": "bun run build",
    "fmt": "prettier --write .",
    "check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "prettier": "^3.6.2",
    "typescript": "7.0.2",
    "zod": "^4.6.6"
  }
}
