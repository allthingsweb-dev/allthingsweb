{
  "name": "allthings-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "fmt": "prettier --write .",
    "check": "prettier --check .",
    "typecheck": "bun run build && tsc --noEmit && tsc --noEmit -p src/client",
    "xss-scan": "bun run build && ../tools/xss-scan/node_modules/.bin/xss-scan --project tsconfig.json",
    "test": "bun run build && bun test"
  },
  "dependencies": {
    "@effect/sql-pg": "4.0.0",
    "@kitajs/html": "4.2.13",
    "@modelcontextprotocol/server": "2.2.0",
    "allthings-brand": "workspace:*",
    "allthings-core": "workspace:*",
    "effect": "4.0.0",
    "uqr": "0.1.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.0",
    "@effect/platform-node": "4.0.0",
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@types/bun": "1.4.2",
    "alchemy": "2.0.0-beta.81",
    "axe-core": "4.11.0",
    "fast-xml-parser": "5.11.1",
    "html-validate": "11.16.1",
    "jsdom": "27.4.0",
    "marked": "18.0.14",
    "prettier": "3.6.2",
    "typescript": "7.0.2"
  }
}
