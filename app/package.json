{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "env:pull:development": "better-env pull --environment development",
    "env:pull:preview": "better-env pull --environment preview",
    "env:pull:production": "better-env pull --environment production",
    "env:validate": "better-env validate --environment development",
    "env:validate:production": "better-env validate --environment production",
    "build:preview": "bun --env-file=.env.preview run build",
    "dev": "bun run env:validate && next dev",
    "build": "bun run env:validate:production && next build",
    "start": "next start",
    "fmt": "prettier --write .",
    "check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit --project scripts/tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "bun test",
    "mcp:debug": "bunx @modelcontextprotocol/inspector bun run scripts/mcp-server.ts"
  },
