# Sever origin
ORIGIN="http://localhost:3000"

# Neon Postgres connection string
DATABASE_URL=

# Public media bucket; uploads are optional locally (values from `vercel env pull`)
MEDIA_PUBLIC_URL="https://media.allthings.dev"
MEDIA_UPLOAD_URL=
MEDIA_UPLOAD_TOKEN=

# "on" sends every request to allthings.dev (src/lib/cutover); off by default
# ALLTHINGS_DEV_REDIRECT=off

# Optionals (comment out if not using)
# RESEND_API_KEY=
# LUMA_API_KEY=
# For build step w/ Sentry
SENTRY_AUTH_TOKEN=