# dependencies (bun install)
node_modules

# The hub's local state: never committed. The config holds the Bridge's
# app key and the host token, the codes file the codes' salted hashes, and
# the audit log what each code did on the night.
aux.config.json
aux.codes.json
# Its uniquely named temporary writes, its lock, and stale locks set aside
# (src/codes.ts).
aux.codes.json.*.tmp
aux.codes.json.lock
aux.codes.json.lock.*.stale
*.jsonl

# The tests' scratch directories, removed when they finish
tests/.tmp-*

# Finder (MacOS) folder config
.DS_Store
